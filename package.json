{
  "name": "iamyancong-official-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "雨燕前端体系（Yuyan Frontend）官网",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@8.10.0",
  "scripts": {
    "dev": "vite",
    "build": "vite-ssg build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "type-check": "vue-tsc --noEmit -p tsconfig.json",
    "check": "pnpm lint && pnpm type-check && pnpm build"
  },
  "dependencies": {
    "@tresjs/core": "^5.12.0",
    "@unhead/vue": "^2.1.2",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/core": "^1.48.2",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "three": "^0.187.0",
    "vue": "^3.5.45",
    "vue-router": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.12.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.8",
    "vite-ssg": "^28.3.0",
    "vue-tsc": "^3.3.14"
